# macOS code signing + notarization credentials.
#
# Copy this file to `.env` (which is gitignored) and replace every REPLACE_ME
# with a real value. These are consumed by scripts/notarize.js during
# `npm run dist:mac`. Never commit the filled-in `.env`.
#
# (Note: the original request listed APPLE_TEAM_ID twice — it's a single value,
#  shown once here.)

# Apple Developer account email address (your Apple ID).
APPLE_ID=REPLACE_ME

# Your 10-character Team ID. Find it at https://developer.apple.com/account
# under "Membership details" once Certificates, IDs & Profiles is active.
APPLE_TEAM_ID=REPLACE_ME

# App-specific password generated at https://appleid.apple.com (Sign-In and
# Security -> App-Specific Passwords). NOT your normal Apple ID password.
APPLE_APP_SPECIFIC_PASSWORD=REPLACE_ME
