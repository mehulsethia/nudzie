{
  "name": "nudzie",
  "productName": "Nudzie",
  "version": "0.1.5",
  "description": "A friendly character walks in from a corner of your screen to nudge you — before calendar meetings and on your own personal-reminder schedule.",
  "author": "Nudzie",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.cjs",
    "gen:icons": "node scripts/generate-tray-icon.cjs && node scripts/generate-app-icon.cjs",
    "dev": "npm run gen:icons && electron-vite dev",
    "build": "npm run gen:icons && electron-vite build",
    "preview": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "jimp": "0.22.12",
    "typescript": "^5.6.0",
    "vercel": "^57.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "ical.js": "^2.2.1",
    "node-machine-id": "^1.1.12"
  }
}
